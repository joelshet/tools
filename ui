#!/usr/bin/env python3
# /// script
# requires-python = ">=3.10"
# dependencies = ["playwright"]
# ///
"""Operate a website as a persistent session; every action returns the diff it caused.

A daemon holds one headless (or headed) browser per named session; commands talk
to it over a Unix socket in ~/.tools/ui/. Snapshots are viewport-scoped TSV rows
(id kind label cx cy w h state); ids are stable for the life of the session, so
a remembered id stays valid until the element leaves the page. Actions answer
with the change they caused, so "= N unchanged" alone means the action did
nothing visible; state flips (checkbox, radio, tab, select) report themselves,
and toasts (role=status/alert, aria-live) appear as `status` rows. A `pinned`
state marks fixed or sticky elements that stay on screen while scrolling. `text`
prints the page's readable text; snapshots list only interactive elements and
headings. Labels are visible text (screen-reader-only spans dropped), or the
aria-label when it says more. Off-viewport targets are scrolled into view
before a click; targets under a sticky header are re-centered first. `scroll DY
TARGET` scrolls the pane holding TARGET (drawers, virtual lists) instead of the
page. `wait --for TEXT` returns as soon as TEXT shows up. `open` with a flag the
live session lacks (--headed, --video, --profile) restarts that session.
New tabs are followed automatically. One-time setup beyond deps:
playwright install chromium.
"""
import argparse
import collections
import json
import os
import pathlib
import re
import socket
import subprocess
import sys
import time

STATE = pathlib.Path.home() / ".tools" / "ui"
W, H = 375, 812
SCREENSHOT_TOKENS = 1624  # 750x1624 @2x via the ~(w*h)/750 vision formula
TOL = 3  # px of coordinate jitter that still counts as unchanged
PICKER = {"time", "date", "datetime-local", "month", "week"}  # native picker overlay eats all input
FIELDS = {"text", "search", "email", "tel", "url", "number", "password", "textarea", "combobox", "textbox", "input"}
TEXT_CAP = 6000  # chars of readable text per `text` call

EXTRACT = r"""(() => {
  const seen = new Set(), rows = [];
  const sx = window.scrollX, sy = window.scrollY;
  const sel = 'a, button, input, select, textarea, summary, h1, h2, h3, img, [onclick], ' +
    '[contenteditable="true"], [role="button"], [role="link"], [role="menuitem"], [role="tab"], ' +
    '[role="checkbox"], [role="switch"], [role="textbox"], [role="option"], [role="radio"], ' +
    '[role="menuitemradio"], [role="status"], [role="alert"], [aria-live]';
  // visible text only: skips screen-reader-only spans (1px clips) that pollute labels
  const vis = (n) => {
    if (n.nodeType === 3) return n.textContent;
    if (n.nodeType !== 1) return '';
    const cs = getComputedStyle(n);
    if (cs.display === 'none' || cs.visibility === 'hidden' || cs.opacity === '0') return '';
    const b = n.getBoundingClientRect();
    if ((b.width < 2 || b.height < 2) && n.textContent.trim()) return '';
    let out = '';
    for (const c of n.childNodes) out += vis(c) + ' ';
    return out;
  };
  for (const el of document.querySelectorAll(sel)) {
    let r = el.getBoundingClientRect();
    const tg = el.tagName.toLowerCase(), rl = el.getAttribute('role');
    const field = tg === 'input' || tg === 'textarea' || rl === 'combobox' || rl === 'textbox';
    if (field && r.width < 8) {  // auto-sizing inputs are 0-wide until typed in: use the visible field box
      let box = el.parentElement;
      while (box && box !== document.body && box.getBoundingClientRect().width < 40) box = box.parentElement;
      if (box && box !== document.body) r = box.getBoundingClientRect();
    }
    if (r.width < 8 || r.height < 8) continue;
    if (!el.getClientRects().length) continue;
    // clip to scrolling ancestors: a row scrolled out of its pane is not clickable
    let cl = {left: r.left, top: r.top, right: r.right, bottom: r.bottom};
    for (let p = el.parentElement; p && p !== document.body; p = p.parentElement) {
      if (getComputedStyle(p).overflowY === 'visible') continue;
      const b = p.getBoundingClientRect();
      cl = {left: Math.max(cl.left, b.left), top: Math.max(cl.top, b.top), right: Math.min(cl.right, b.right), bottom: Math.min(cl.bottom, b.bottom)};
    }
    if (cl.right - cl.left < 8 || cl.bottom - cl.top < 8) continue;
    r = {left: cl.left, top: cl.top, width: cl.right - cl.left, height: cl.bottom - cl.top};
    const st = getComputedStyle(el);
    if (st.visibility === 'hidden' || st.display === 'none' || st.opacity === '0') continue;
    let hidden = false;
    for (let p = el.parentElement; p; p = p.parentElement) {
      const ps = getComputedStyle(p);
      if (ps.display === 'none' || ps.visibility === 'hidden' || ps.opacity === '0') { hidden = true; break; }
    }
    if (hidden) continue;
    const tag = el.tagName.toLowerCase(), role = el.getAttribute('role');
    let kind = role || tag, state = '-';
    let text = vis(el).trim().replace(/\s+/g, ' ');
    const al = (el.getAttribute('aria-label') || '').trim().replace(/\s+/g, ' ');
    if (al.length > text.length) text = al;  // e.g. "See your cart, 2 items" over "See your cart"
    text = (text || el.title || '').slice(0, 40);
    if (role === 'status' || role === 'alert' || el.hasAttribute('aria-live')) {
      if (!text || (role !== 'status' && role !== 'alert' && !/^(polite|assertive)$/.test(el.getAttribute('aria-live')))) continue;
      kind = 'status';
      if (el.closest('button, a, [role="button"]')) continue;  // its text is already in the button's label
    }
    if (tag === 'a') kind = role || 'link';
    if (/^h[1-3]$/.test(tag)) kind = 'heading';
    if (el.isContentEditable) kind = 'textbox';
    if (tag === 'img') { kind = 'img'; text = (el.alt || '').slice(0, 40); if (!text) continue; }
    const fieldName = (el2) => {
      const lab = el2.closest('label') || (el2.id && document.querySelector('label[for="' + el2.id + '"]'));
      return ((lab && lab.innerText) || el2.getAttribute('aria-label') || el2.placeholder || el2.name || '')
        .trim().replace(/\s+/g, ' ').slice(0, 40);
    };
    if (tag === 'textarea') {
      text = fieldName(el);
      state = (el.value || '').trim().replace(/\s+/g, ' ').slice(0, 25) || '-';
    }
    if (el.isContentEditable) {
      text = (el.getAttribute('aria-label') || el.getAttribute('data-placeholder') || 'editor').slice(0, 40);
      state = (el.innerText || '').trim().replace(/\s+/g, ' ').slice(0, 25) || '-';
    }
    if (tag === 'select') {
      text = (el.name || el.getAttribute('aria-label') || '').slice(0, 40);
      state = (el.selectedOptions[0]?.textContent || '').trim().slice(0, 25) || '-';
    }
    if (tag === 'input') {
      kind = el.type || 'input';
      text = fieldName(el);
      if (el.type === 'password') state = el.value ? '***' : '-';
      else state = (el.value || '').trim().replace(/\s+/g, ' ').slice(0, 25) || '-';
      if (el.type === 'checkbox' || el.type === 'radio') state = el.checked ? 'on' : 'off';
    }
    if (role === 'checkbox' || role === 'switch' || role === 'tab' || role === 'option' || role === 'radio' || role === 'menuitemradio')
      state = (el.getAttribute('aria-checked') === 'true' || el.getAttribute('aria-selected') === 'true') ? 'on' : 'off';
    // fixed or sticky (itself or a near ancestor): stays on screen, so no scrolling is needed to reach it
    let pinned = false;
    for (let p = el, i = 0; p && p !== document.body && i < 6; p = p.parentElement, i++) {
      const ps = getComputedStyle(p).position;
      if (ps === 'fixed' || ps === 'sticky') { pinned = true; break; }
    }
    if (pinned) state = state === '-' ? 'pinned' : state + ' pinned';
    const cx = Math.round(r.left + sx + r.width / 2), cy = Math.round(r.top + sy + r.height / 2);
    const key = cx + '|' + cy + '|' + text;  // nested same-label interactives collapse to one row
    if (seen.has(key)) continue;
    seen.add(key);
    rows.push([kind, (text || '-').replace(/\t/g, ' '), cx, cy, Math.round(r.width), Math.round(r.height), state]);
  }
  return { rows, sy: Math.round(sy), sx: Math.round(sx), sh: document.documentElement.scrollHeight,
           vw: window.innerWidth, vh: window.innerHeight };
})()"""

SELECT = r"""([x, y, opt]) => {
  const el = document.elementFromPoint(x, y);
  if (!el || el.tagName !== 'SELECT') return 'not a select element';
  const opts = [...el.options];
  const o = opts.find(o => o.textContent.trim().toLowerCase() === opt.toLowerCase())
        || opts.find(o => o.textContent.trim().toLowerCase().includes(opt.toLowerCase()));
  if (!o) {
    let names = opts.map(o => o.textContent.trim());
    if (names.length > 30) names = names.slice(0, 30).concat('… +' + (names.length - 30) + ' more');
    return 'no option matching ' + JSON.stringify(opt) + '; options: ' + names.join(' | ');
  }
  el.value = o.value;
  el.dispatchEvent(new Event('input', {bubbles: true}));
  el.dispatchEvent(new Event('change', {bubbles: true}));
  return '';
}"""

SCROLL = r"""([dy, x, y]) => {
  const scrollable = (el) => el.scrollHeight > el.clientHeight + 20 && /(auto|scroll|overlay)/.test(getComputedStyle(el).overflowY);
  if (x != null) {  // scroll the pane that contains the target element
    for (let el = document.elementFromPoint(x, y); el && el !== document.body; el = el.parentElement)
      if (scrollable(el)) { const t0 = el.scrollTop; el.scrollBy(0, dy); if (el.scrollTop !== t0) return 'pane'; }
  }
  const y0 = window.scrollY;
  window.scrollBy(0, dy);
  if (window.scrollY !== y0) return 'window';
  let best = null;
  for (const el of document.querySelectorAll('*')) {
    if (el.scrollHeight > el.clientHeight + 100) {
      const s = getComputedStyle(el);
      if (/(auto|scroll|overlay)/.test(s.overflowY) && (!best || el.clientHeight > best.clientHeight)) best = el;
    }
  }
  if (best) { const t0 = best.scrollTop; best.scrollBy(0, dy); if (best.scrollTop !== t0) return 'pane'; }
  return '';
}"""

OBSCURED = r"""([x, y, w, h]) => {
  // true when the point is covered by something outside the target's box (sticky header, overlay)
  const hit = document.elementFromPoint(x, y);
  if (!hit) return false;
  for (let el = hit; el; el = el.parentElement) {
    const r = el.getBoundingClientRect();
    if (Math.abs(r.width - w) <= 2 && Math.abs(r.height - h) <= 2 && Math.abs(r.left + r.width / 2 - x) <= 2) return false;
  }
  return true;
}"""

FOCUSED = r"""() => {
  const a = document.activeElement;
  if (!a || a === document.body) return false;
  const t = a.tagName.toLowerCase(), r = a.getAttribute('role');
  return t === 'input' || t === 'textarea' || t === 'select' || a.isContentEditable || r === 'textbox' || r === 'combobox';
}"""

FOCUS_NEAR = r"""([x, y]) => {
  // a 0-wide input listed by its container box: the mouse click hit the container, so focus the input itself
  const inside = (r) => r.left <= x && x <= r.right && r.top <= y && y <= r.bottom;
  let best = null, bd = 1e9;
  for (const el of document.querySelectorAll('input, textarea, [role="combobox"], [role="textbox"]')) {
    let box = el;
    while (box && box !== document.body && box.getBoundingClientRect().width < 40) box = box.parentElement;
    if (!box || !inside(box.getBoundingClientRect())) continue;
    const r = el.getBoundingClientRect(), d = Math.hypot(r.left + r.width / 2 - x, r.top + r.height / 2 - y);
    if (d < bd) { best = el; bd = d; }
  }
  if (best) best.focus();
  return !!best;
}"""

HTML = r"""([x, y, whole]) => {
  let el = whole ? document.body : document.elementFromPoint(x, y);
  if (!el) return '';
  for (let i = 0; i < 3 && !whole && el.parentElement && el.parentElement !== document.body
       && el.outerHTML.length < 400; i++) el = el.parentElement;
  const KEEP = new Set(['href', 'src', 'alt', 'title', 'type', 'name', 'value', 'placeholder', 'role',
    'id', 'for', 'action', 'method', 'colspan', 'rowspan', 'datetime', 'selected', 'checked', 'disabled',
    'open', 'label']);
  const clean = (n) => {
    if (n.attributes) for (const a of [...n.attributes])
      if (!KEEP.has(a.name) && !a.name.startsWith('aria-')) n.removeAttribute(a.name);
    for (const c of [...n.children]) {
      if (/^(script|style|noscript|template|svg|link|meta)$/i.test(c.tagName)) { c.remove(); continue; }
      clean(c);
    }
  };
  const clone = el.cloneNode(true);
  clean(clone);
  return clone.outerHTML;
}"""

TEXT = r"""(document.querySelector('main, article, [role="main"]') || document.body).innerText"""

RIPPLE = """
addEventListener('mousedown', e => {
  const d = document.createElement('div');
  d.style.cssText = `position:fixed;left:${e.clientX-14}px;top:${e.clientY-14}px;width:28px;height:28px;
    border:3px solid #e33;border-radius:50%;pointer-events:none;z-index:2147483647;transition:all .45s;opacity:1`;
  document.documentElement.appendChild(d);
  requestAnimationFrame(() => { d.style.transform = 'scale(2.2)'; d.style.opacity = '0'; });
  setTimeout(() => d.remove(), 600);
}, true);
"""


# ---------- snapshot & diff ----------

def frames(page):
    """Direct child frames of the main frame, with their page offsets."""
    for fr in page.frames:
        if fr is page.main_frame or fr.parent_frame is not page.main_frame:
            continue
        try:
            box = fr.frame_element().bounding_box()
        except Exception:
            continue
        if box and box["width"] >= 40 and box["height"] >= 40:
            yield fr, box


def extract(state):
    """Full-page rows with session-stable ids; returns the viewport slice."""
    page = state["page"]
    for attempt in range(3):
        try:
            data = page.evaluate(EXTRACT)
            break
        except Exception as e:  # a click that navigates destroys the old document mid-snapshot
            if "Execution context was destroyed" not in str(e) or attempt == 2:
                raise
            settle(page)
    raw = list(data["rows"])
    for fr, box in frames(page):
        try:
            sub = fr.evaluate(EXTRACT)
        except Exception:
            continue
        ox, oy = box["x"] + data["sx"] - sub["sx"], box["y"] + data["sy"] - sub["sy"]
        raw += [[k, l, round(cx + ox), round(cy + oy), w, h, s] for k, l, cx, cy, w, h, s in sub["rows"]]
    rows = [{"kind": k, "label": l, "cx": cx, "cy": cy, "w": w, "h": h, "state": s}
            for k, l, cx, cy, w, h, s in raw]
    pool = collections.defaultdict(list)
    for r in state["all"]:
        pool[(r["kind"], r["label"])].append(r)
    for r in rows:
        cands = pool.get((r["kind"], r["label"]))
        if cands:
            c = min(cands, key=lambda o: (o["cx"] - r["cx"]) ** 2 + (o["cy"] - r["cy"]) ** 2)
            cands.remove(c)
            r["id"] = c["id"]
        else:
            state["n"] += 1
            r["id"] = f"e{state['n']}"
    state["all"] = rows
    state["sy"], state["sh"] = data["sy"], data["sh"]
    state["vw"], state["vh"] = data["vw"], data["vh"]  # CSS viewport; 980-ish when a page has no meta viewport
    return [r for r in rows if data["sy"] - 40 <= r["cy"] <= data["sy"] + data["vh"] + 40
            and data["sx"] - 40 <= r["cx"] <= data["sx"] + data["vw"] + 40]


def ser(rows):
    head = "id\tkind\tlabel\tcx\tcy\tw\th\tstate"
    return "\n".join([head] + ["\t".join(str(r[k]) for k in ("id", "kind", "label", "cx", "cy", "w", "h", "state"))
                              for r in rows])


def fmt(r, coords=True):
    s = f"{r['id']} {r['kind']} \"{r['label']}\""
    if coords:
        s += f" @{r['cx']},{r['cy']} {r['w']}x{r['h']}"
    if r["state"] != "-":
        s += f" [{r['state']}]"
    return s


def diff(old, new):
    by_id = {r["id"]: r for r in old}
    unchanged, flipped, added = 0, [], []
    shifts = collections.defaultdict(list)
    for r in new:
        o = by_id.pop(r["id"], None)
        if o is None:
            added.append(r)
            continue
        dx, dy = r["cx"] - o["cx"], r["cy"] - o["cy"]
        if abs(dx) > TOL or abs(dy) > TOL:
            shifts[(dx, dy)].append(r)
        elif r["state"] != o["state"]:
            flipped.append(r)
        else:
            unchanged += 1
    removed = list(by_id.values())

    out = [f"= {unchanged} unchanged"]
    for r in flipped:
        out.append("~ " + fmt(r, coords=False))
    for (dx, dy), rs in sorted(shifts.items(), key=lambda kv: -len(kv[1])):
        if len(rs) >= 3:
            out.append(f"~ {len(rs)} rows shifted ({dx:+},{dy:+})")
        else:
            for r in rs:
                out.append(f"~ {r['id']} {r['kind']} \"{r['label']}\" ->{r['cx']},{r['cy']} ({dx:+},{dy:+})")
    for r in added:
        out.append("+ " + fmt(r))
    if len(removed) > 10 and len(removed) * 3 > len(old):
        out.append(f"- {len(removed)} rows removed")
    else:
        for r in removed:
            out.append("- " + fmt(r, coords=False) + f" @{r['cx']},{r['cy']}")
    return "\n".join(out)


# ---------- daemon ----------

def run_daemon(url, sock, headed=False, video=False, profile_dir=None):
    from playwright.sync_api import sync_playwright

    if os.path.exists(sock):
        os.unlink(sock)
    srv = socket.socket(socket.AF_UNIX)
    srv.bind(sock)
    srv.listen(1)
    ledger = []
    with sync_playwright() as pl:
        ctx_opts = {"viewport": {"width": W, "height": H}, "is_mobile": True}  # honor meta viewport
        if video:
            (STATE / "video").mkdir(parents=True, exist_ok=True)
            ctx_opts.update(record_video_dir=str(STATE / "video"), record_video_size={"width": W, "height": H})
        if profile_dir:
            # logged-in sessions: cookies and storage persist in the profile
            ctx = pl.chromium.launch_persistent_context(str(profile_dir), headless=not headed, **ctx_opts)
        else:
            browser = pl.chromium.launch(headless=not headed)
            ctx = browser.new_context(**ctx_opts)
        if headed or video:
            ctx.add_init_script(RIPPLE)
        dialogs = []

        def arm(p):
            p.on("dialog", lambda d: (dialogs.append(f"{d.type}: {d.message}"), d.accept()))

        for p in ctx.pages:  # persistent context: initial page predates the listener
            arm(p)
        ctx.on("page", arm)
        page = ctx.pages[0] if ctx.pages else ctx.new_page()
        page.goto(url, wait_until="load")
        page.wait_for_timeout(1500)

        state = {"page": page, "all": [], "n": 0, "sy": 0, "sh": 0, "url": page.url, "dialogs": dialogs,
                 "w": W, "h": H, "headed": headed}
        state["last"] = extract(state)
        print("ready", flush=True)
        while True:
            conn, _ = srv.accept()
            f = conn.makefile("rwb")
            req = json.loads(f.readline())
            t0 = time.time()
            try:
                out = handle(state, req)
            except Exception as e:
                out = {"error": f"{type(e).__name__}: {e}"}
            out["ms"] = int((time.time() - t0) * 1000)
            if req["op"] not in ("ping", "stop", "ledger") and "error" not in out:
                sent = out.get("diff") or out.get("tsv") or out.get("text") or ""
                ledger.append({"op": req.get("label", req["op"]), "ms": out["ms"],
                               "sent": len(sent), "tree": tree_bytes(state["page"])})
            if req["op"] == "ledger":
                out["rows"] = ledger
            f.write(json.dumps(out).encode() + b"\n")
            f.flush()
            conn.close()
            if req["op"] == "stop":
                break
        vid = state["page"].video if video else None
        ctx.close()
        if vid:
            print(f"video: {vid.path()}", flush=True)
        if not profile_dir:
            browser.close()
    os.unlink(sock)


def tree_bytes(page):
    try:
        return len(page.locator("body").aria_snapshot(timeout=2000))
    except Exception:
        return 0


def settle(page):
    try:
        page.wait_for_load_state("load", timeout=3000)
    except Exception:
        pass
    page.wait_for_timeout(600)


def current_page(state):
    """Follow new tabs and survive closed ones; returns True if the page changed."""
    pages = [p for p in state["page"].context.pages if not p.is_closed()]
    if not pages:
        raise RuntimeError("all pages closed")
    if state["page"].is_closed() or pages[-1] is not state["page"]:
        state["page"] = pages[-1]
        try:
            state["page"].set_viewport_size({"width": state["w"], "height": state["h"]})
            state["page"].wait_for_load_state("load", timeout=5000)
            state["page"].bring_to_front()
        except Exception:
            pass
        return True
    return False


def resolve(rows, target, index):
    if target.startswith("e") and target[1:].isdigit():
        hits = [r for r in rows if r["id"] == target]
    else:
        t = target.casefold()
        hits = [r for r in rows if r["label"].casefold() == t]
        if not hits:
            hits = [r for r in rows if t in r["label"].casefold()
                    or (len(r["label"]) == 40 and t.startswith(r["label"].casefold()))]  # label was truncated
        if not hits and " " in t:
            # every word of the target in order somewhere in the label: survives a shell-eaten "$3" in "$3.95"
            def in_order(label):
                pos = 0
                for w in t.split():
                    pos = label.find(w, pos)
                    if pos < 0:
                        return False
                    pos += len(w)
                return True
            hits = [r for r in rows if in_order(r["label"].casefold())]
    if not hits:
        raise ValueError(f"no element matching {target!r} — run read for a fresh snapshot")
    if len(hits) > 1 and not index:
        opts = "; ".join(f"{r['id']}:{r['label'][:25]}@{r['cx']},{r['cy']}" for r in hits[:6])
        raise ValueError(f"{len(hits)} matches for {target!r}: {opts} — pass an index or id")
    return hits[(index or 1) - 1]


def clip(txt, off):
    txt = re.sub(r"\n{3,}", "\n\n", txt).strip()
    chunk = txt[off:off + TEXT_CAP]
    more = len(txt) - off - TEXT_CAP
    if more > 0:
        chunk += f"\n…(+{more} more chars — pass offset {off + TEXT_CAP} to continue)"
    return chunk


def pos(state):
    vh = state.get("vh") or state["h"]
    if state["sh"] <= vh + 50:
        return None
    s = f"y {state['sy']}-{min(state['sy'] + vh, state['sh'])} of {state['sh']}"
    above = sum(1 for r in state["all"] if r["cy"] < state["sy"] - 40)
    below = sum(1 for r in state["all"] if r["cy"] > state["sy"] + vh + 40)
    if above:
        s += f"; {above} elems above"
    if below:
        s += f"; {below} elems below"
    return s


def locate(state, target, index):
    """Resolve in the viewport, else scroll an off-viewport match into view."""
    try:
        return resolve(state["last"], target, index), None
    except ValueError:
        try:
            r = resolve(state["all"], target, index)
        except ValueError:
            state["last"] = extract(state)  # the page may have changed since the last snapshot
            try:
                return resolve(state["last"], target, index), None
            except ValueError:
                r = resolve(state["all"], target, index)
        state["page"].evaluate(f"window.scrollTo(0, {max(0, r['cy'] - (state.get('vh') or state['h']) // 2)})")
        state["page"].wait_for_timeout(300)
        state["last"] = extract(state)
        return resolve(state["last"], r["id"], None), f"scrolled to {r['id']}"


BOT_CHECK = r"""() => /Performing security verification|Verify you are human|Checking your browser|Just a moment/i.test(document.body.innerText.slice(0, 2000))"""


def bot_check(state):
    if state.get("headed") or not state["page"].evaluate(BOT_CHECK):
        return None
    return "bot check: headless browsers rarely pass it — stop and reopen with: ui open --headed URL"


def act_result(state, note=None):
    switched = current_page(state)
    new = extract(state)
    out = {"diff": diff(state["last"], new)}
    state["last"] = new
    bot = bot_check(state)
    notes = ([note] if note else []) + ([bot] if bot else []) + (["switched to new tab"] if switched else []) \
        + [f"dialog {d} (accepted)" for d in state["dialogs"]]
    state["dialogs"].clear()
    if notes:
        out["note"] = "; ".join(notes)
    if state["page"].url != state["url"]:
        out["url"] = state["url"] = state["page"].url
    return out


def click_at(state, r):
    page = state["page"]
    if r["kind"] in ("file", "color"):
        raise ValueError(f"{r['kind']} inputs open a native dialog; not supported")
    if r["kind"] == "select":
        raise ValueError(f"use select {r['id']} OPTION to choose from a dropdown")
    x, y = r["cx"], r["cy"] - page.evaluate("window.scrollY")
    if page.evaluate(OBSCURED, [x, y, r["w"], r["h"]]):
        # covered by a sticky header or footer: bring it to the middle of the viewport and retry
        page.evaluate(f"window.scrollTo(0, {max(0, r['cy'] - (state.get('vh') or state['h']) // 2)})")
        page.wait_for_timeout(300)
        state["last"] = extract(state)
        r = next((n for n in state["last"] if n["id"] == r["id"]), r)
        x, y = r["cx"], r["cy"] - page.evaluate("window.scrollY")
    if r["kind"] in PICKER:
        page.evaluate(f"document.elementFromPoint({x},{y})?.focus()")
    else:
        page.mouse.click(x, y)
        if r["kind"] in FIELDS and not page.evaluate(FOCUSED):
            page.evaluate(FOCUS_NEAR, [x, y])


def handle(state, req):
    op = req["op"]
    if op in ("ping", "stop", "ledger"):
        return {"ok": op}
    current_page(state)
    page = state["page"]
    if op == "read":
        state["last"] = extract(state)
        return {k: v for k, v in
                {"tsv": ser(state["last"]), "url": page.url, "pos": pos(state), "note": bot_check(state)}.items() if v}
    if op == "text":
        txt = page.evaluate(TEXT)
        for fr, _ in frames(page):
            try:
                txt += "\n" + fr.evaluate(TEXT)
            except Exception:
                pass
        return {"text": clip(txt, req.get("offset") or 0), "url": page.url}
    if op == "html":
        if req.get("target"):
            r, _ = locate(state, req["target"], req.get("index"))
            raw = page.evaluate(HTML, [r["cx"], r["cy"] - page.evaluate("window.scrollY"), False])
        else:
            raw = page.evaluate(HTML, [0, 0, True])
        return {"text": clip(raw, req.get("offset") or 0), "url": page.url}
    if op == "open":
        page.goto(req["url"], wait_until="load")
        settle(page)
        state["last"] = extract(state)
        state["url"] = page.url
        return {k: v for k, v in
                {"tsv": ser(state["last"]), "url": page.url, "pos": pos(state), "note": bot_check(state)}.items() if v}
    if op == "click":
        r, note = locate(state, req["target"], req.get("index"))
        click_at(state, r)
        settle(page)
        out = act_result(state, note)
        if "\n" not in out["diff"] and "url" not in out and "note" not in out:
            page.wait_for_timeout(900)  # panels that animate open or closed land after settle()
            out = act_result(state, note)
            if "\n" not in out["diff"] and "url" not in out and "note" not in out:
                out["diff"] += "\n(no visible change)"
        return out
    if op == "select":
        r, note = locate(state, req["target"], req.get("index"))
        err = page.evaluate(SELECT, [r["cx"], r["cy"] - page.evaluate("window.scrollY"), req["option"]])
        if err:
            raise ValueError(err)
        settle(page)
        return act_result(state, note)
    if op == "type":
        note = None
        if req.get("into"):
            r, note = locate(state, req["into"], req.get("index"))
            click_at(state, r)
            page.wait_for_timeout(150)
        elif not page.evaluate(FOCUSED):
            raise ValueError("nothing editable is focused — pass --into TARGET to click a field first")
        page.keyboard.type(req["text"], delay=25)
        page.wait_for_timeout(700)
        return act_result(state, note)
    if op == "hover":
        r, note = locate(state, req["target"], req.get("index"))
        page.mouse.move(r["cx"], r["cy"] - page.evaluate("window.scrollY"))
        page.wait_for_timeout(500)
        return act_result(state, note)
    if op == "press":
        page.keyboard.press(req["key"])
        settle(page)
        return act_result(state)
    if op == "goto":
        page.goto(req["url"], wait_until="load")
        settle(page)
        return act_result(state)
    if op == "back":
        page.go_back(wait_until="load")
        settle(page)
        return act_result(state)
    if op == "eval":  # internal: debugging escape hatch
        return {"text": json.dumps(page.evaluate(req["js"]))[:2000]}
    if op == "resize":
        state["w"], state["h"] = (1280, 900) if req["preset"] == "desktop" else (W, H)
        page.set_viewport_size({"width": state["w"], "height": state["h"]})
        settle(page)
        state["last"] = extract(state)
        return {k: v for k, v in
                {"tsv": ser(state["last"]), "url": page.url, "pos": pos(state)}.items() if v}
    if op == "wait":
        secs = float(req.get("secs") or 2)
        if req.get("for"):
            needle = req["for"].casefold()
            deadline = time.time() + min(secs, 60)
            while True:
                page.wait_for_timeout(250)
                txt = page.evaluate("document.body.innerText")
                if needle in txt.casefold():
                    return act_result(state, f"found {req['for']!r}")
                if time.time() > deadline:
                    raise ValueError(f"{req['for']!r} did not appear within {min(secs, 60):g}s")
        page.wait_for_timeout(min(secs, 10) * 1000)
        return act_result(state)
    if op == "scroll":
        # scrollBy, not mouse.wheel: wheel events are ignored under touch emulation
        dy = req["dy"]
        vh = state.get("vh") or state["h"]
        if dy in ("down", "page"):
            dy = int(vh * 0.8)
        elif dy == "up":
            dy = -int(vh * 0.8)
        args = [int(dy), None, None]
        if req.get("target"):
            r, _ = locate(state, req["target"], None)
            args[1:] = [r["cx"], r["cy"] - page.evaluate("window.scrollY")]
        moved = page.evaluate(SCROLL, args)
        page.wait_for_timeout(500)
        out = act_result(state, "scrolled inner pane" if moved == "pane" else None)
        if not moved:
            out["diff"] += "\n(nothing scrolled — page and panes fit their viewports; resize desktop may help)"
        if pos(state):
            out["pos"] = pos(state)
        return out
    return {"error": f"unknown op {op}"}


# ---------- client ----------

def call(sock, req):
    c = socket.socket(socket.AF_UNIX)
    c.connect(sock)
    f = c.makefile("rwb")
    f.write(json.dumps(req).encode() + b"\n")
    f.flush()
    resp = json.loads(f.readline())
    c.close()
    if "error" in resp:
        print(f"error: {resp['error']}", file=sys.stderr)
        sys.exit(1)
    return resp


def alive(sock):
    if not os.path.exists(sock):
        return False
    try:
        call(sock, {"op": "ping"})
        return True
    except (ConnectionRefusedError, FileNotFoundError, OSError, ValueError):
        return False  # ValueError: empty reply from a daemon that is shutting down


def ensure_session(name, sock, url, flags):
    flagfile = STATE / f"{name}.flags"
    if alive(sock):
        have = flagfile.read_text().split() if flagfile.exists() else []
        missing = [f for f in flags if f not in have]
        if not missing:
            return call(sock, {"op": "open", "url": url, "label": "open"})
        # a live session can't gain --headed/--video/--profile; restart it with the union
        print(f"restarting session {name!r} with {' '.join(missing)}", file=sys.stderr)
        call(sock, {"op": "stop"})
        for _ in range(20):
            if not alive(sock):
                break
            time.sleep(0.25)
        flags = have + missing
    STATE.mkdir(parents=True, exist_ok=True)
    flagfile.write_text(" ".join(flags))
    log = open(STATE / f"session-{name}.log", "w")
    subprocess.Popen([sys.executable, str(pathlib.Path(__file__).resolve()), "-s", name, "daemon", url, *flags],
                     stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    for _ in range(60):
        if alive(sock):
            return call(sock, {"op": "read", "label": "open"})
        time.sleep(0.5)
    print(f"session {name!r} did not come up; see {STATE}/session-{name}.log", file=sys.stderr)
    sys.exit(1)


def emit(resp):
    parts = []
    if resp.get("note"):
        parts.append("» " + resp["note"])
    if resp.get("url"):
        parts.append("@ " + resp["url"])
    body = resp.get("tsv") or resp.get("diff") or resp.get("text") or resp.get("ok", "")
    if body:
        parts.append(body)
    if resp.get("pos"):
        parts.append(resp["pos"])
    out = "\n".join(parts)
    print(out)
    print(f"[{len(out)}B {resp['ms']}ms]", file=sys.stderr)


def main():
    p = argparse.ArgumentParser(prog="ui", description=__doc__.split("\n")[0])
    p.add_argument("-s", "--session", default="default", help="named session, for driving several sites in parallel (default: default)")
    for flag in ("--headed", "--video", "--profile"):  # accepted before or after `open`
        p.add_argument(flag, action="store_true", help=argparse.SUPPRESS)
    sub = p.add_subparsers(dest="cmd", required=True)
    sp = sub.add_parser("open", help="start a session at URL (or navigate the live one); prints the snapshot")
    sp.add_argument("url", help="page to open")
    sp.add_argument("--headed", action="store_true", default=argparse.SUPPRESS, help="show the browser window (also passes bot checks that block headless)")
    sp.add_argument("--video", action="store_true", default=argparse.SUPPRESS, help="record a webm into ~/.tools/ui/video/")
    sp.add_argument("--profile", action="store_true", default=argparse.SUPPRESS, help="persistent profile for this session name: log in once (headed), stay logged in")
    sub.add_parser("read", help="viewport TSV snapshot; resets the diff baseline")
    sp = sub.add_parser("text", help="readable page text (main content), capped per call")
    sp.add_argument("offset", nargs="?", type=int, default=0, help="character offset to continue from")
    sp = sub.add_parser("html", help="cleaned HTML of the page or one element: structure and attributes the snapshot omits")
    sp.add_argument("target", nargs="?", help="element id (e12) or label text; whole page if omitted")
    sp.add_argument("--offset", type=int, default=0, help="character offset to continue from")
    sp = sub.add_parser("click", help="click an element; returns the diff it caused")
    sp.add_argument("target", help="element id (e12) or label text")
    sp.add_argument("index", nargs="?", type=int, help="pick among multiple label matches (1-based)")
    sp = sub.add_parser("type", help="type into the focused element; returns the diff")
    sp.add_argument("text", help="text to type")
    sp.add_argument("--into", help="element (id or label) to click first")
    sp = sub.add_parser("select", help="choose a dropdown option by its visible text; returns the diff")
    sp.add_argument("target", help="select element (id or label)")
    sp.add_argument("option", help="option text to choose")
    sp = sub.add_parser("hover", help="hover an element (reveals hover menus); returns the diff")
    sp.add_argument("target", help="element id (e12) or label text")
    sp.add_argument("index", nargs="?", type=int, help="pick among multiple label matches (1-based)")
    sp = sub.add_parser("press", help="press a key (Enter, Tab, Escape); returns the diff")
    sp.add_argument("key", help="key name")
    sp = sub.add_parser("goto", help="navigate the session; returns the diff")
    sp.add_argument("url", help="destination URL")
    sub.add_parser("back", help="go back in history; returns the diff")
    sp = sub.add_parser("scroll", help="scroll the page, or the pane holding TARGET; returns the diff")
    sp.add_argument("dy", help="pixels down (negative scrolls up), or down/up for most of a screen")
    sp.add_argument("target", nargs="?", help="element id or label inside the pane to scroll (lists, drawers, modals)")
    sp = sub.add_parser("resize", help="switch viewport; desktop reveals sidebars mobile layouts hide")
    sp.add_argument("preset", choices=["desktop", "mobile"], help="1280x900 or 375x812")
    sp = sub.add_parser("wait", help="wait for the page to change on its own; returns the diff")
    sp.add_argument("secs", nargs="?", type=float, default=2, help="seconds to wait (max 10, default 2; max 60 with --for)")
    sp.add_argument("--for", dest="for_", metavar="TEXT", help="return as soon as TEXT appears on the page; error if it doesn't")
    sub.add_parser("ledger", help="per-action cost vs accessibility-tree and screenshot baselines")
    sp = sub.add_parser("eval", help=argparse.SUPPRESS)
    sp.add_argument("js")
    sub.add_parser("ping", help="check whether the session is alive")
    sub.add_parser("stop", help="end the session")
    sp = sub.add_parser("daemon", help="(internal) run the session process")
    sp.add_argument("url")
    sp.add_argument("--headed", action="store_true")
    sp.add_argument("--video", action="store_true")
    sp.add_argument("--profile", action="store_true")
    a = p.parse_args()

    sock = str(STATE / f"{a.session}.sock")
    if a.cmd == "daemon":
        STATE.mkdir(parents=True, exist_ok=True)
        pdir = STATE / f"profile-{a.session}" if a.profile else None
        run_daemon(a.url, sock, headed=a.headed, video=a.video, profile_dir=pdir)
        return
    if a.cmd == "open":
        flags = [f for f, on in [("--headed", a.headed), ("--video", a.video), ("--profile", a.profile)] if on]
        emit(ensure_session(a.session, sock, a.url, flags))
        return
    if not alive(sock):
        print(f"no live session {a.session!r} — start one with: ui open URL", file=sys.stderr)
        sys.exit(1)

    req = {"op": a.cmd}
    if a.cmd == "click":
        req.update(target=a.target, label=f"click {a.target[:20]}")
        if a.index:
            req["index"] = a.index
    elif a.cmd == "type":
        req.update(text=a.text, label=f"type {a.text[:20]}")
        if a.into:
            req["into"] = a.into
    elif a.cmd == "select":
        req.update(target=a.target, option=a.option, label=f"select {a.option[:20]}")
    elif a.cmd == "hover":
        req.update(target=a.target, label=f"hover {a.target[:20]}")
        if a.index:
            req["index"] = a.index
    elif a.cmd == "press":
        req.update(key=a.key, label=f"press {a.key}")
    elif a.cmd == "goto":
        req.update(url=a.url, label="goto")
    elif a.cmd == "text":
        req.update(offset=a.offset, label="text")
    elif a.cmd == "html":
        req.update(offset=a.offset, label="html")
        if a.target:
            req["target"] = a.target
    elif a.cmd == "resize":
        req.update(preset=a.preset, label=f"resize {a.preset}")
    elif a.cmd == "wait":
        req.update(secs=a.secs, label=f"wait {a.secs}")
        if a.for_:
            req["for"] = a.for_
    elif a.cmd == "eval":
        req["js"] = a.js
    elif a.cmd == "scroll":
        if not re.fullmatch(r"-?\d+|up|down|page", a.dy):
            p.error("scroll dy must be an integer or up/down")
        req.update(dy=a.dy, label=f"scroll {a.dy}")
        if a.target:
            req["target"] = a.target
    resp = call(sock, req)
    if a.cmd == "ledger":
        for r in resp["rows"]:
            print(f"{r['op']:<26}{r['ms']:>6}ms{r['sent']:>8}B sent   (tree {r['tree']}B, screenshot ~{SCREENSHOT_TOKENS}tok)")
    else:
        emit(resp)


if __name__ == "__main__":
    main()
