  if (f.identical) {{
    main.className = 'content';
    main.innerHTML = '<div class="identical"><p>Files are identical</p><span>' + (normalized ? 'after normalization' : 'byte-for-byte') + '</span></div>';
    return;
  }}

  if (currentView === 'inline') {{
    main.className = 'content';
    const cls = f.type === 'json' ? '' : 'prose';
    main.innerHTML = '<article class="' + cls + '">' + d.inline + '</article>';
  }} else if (currentView === 'split') {{
    main.className = 'content split';
    main.innerHTML =
      '<div class="pane old"><div class="pane-label">Before</div>' + d.split_old + '</div>'
      + '<div class="pane new"><div class="pane-label">After</div>' + d.split_new + '</div>';
    syncScroll(main);
  }} else if (currentView === 'triple') {{
    main.className = 'content triple';
    main.innerHTML =
      '<div class="pane old"><div class="pane-label">Before</div>' + d.split_old + '</div>'
      + '<div class="pane mid"><div class="pane-label">Changes</div>' + d.inline + '</div>'
      + '<div class="pane new"><div class="pane-label">After</div>' + d.split_new + '</div>';
    syncScroll(main);
  }} else if (currentView === 'rendered' && d.rendered_merged) {{
    main.className = 'content';
    main.innerHTML = '<article class="rendered">' + d.rendered_merged + '</article>';
  }} else if (currentView === 'text') {{
    const ti = d.text_inline || d.inline;
    const to = d.text_old || d.split_old;
    const tn = d.text_new || d.split_new;
    main.className = 'content triple';
    main.innerHTML =
      '<div class="pane old"><div class="pane-label">Before (text)</div>' + to + '</div>'
      + '<div class="pane mid"><div class="pane-label">Changes (text)</div>' + ti + '</div>'
      + '<div class="pane new"><div class="pane-label">After (text)</div>' + tn + '</div>';
    syncScroll(main);
  }} else if (currentView === 'summary') {{
    main.className = 'content';
    if (d.changes && d.changes.length > 0) {{
      let rows = d.changes.map(c =>
        '<tr><td class="path">' + esc(c.path) + '</td><td class="type">' + esc(c.type) + '</td>'
        + '<td class="old-val">' + esc(c.old || '') + '</td><td class="new-val">' + esc(c.new || '') + '</td></tr>'
      ).join('');
      main.innerHTML = '<div class="summary"><table><tr><th>Path</th><th>Type</th><th>Old</th><th>New</th></tr>' + rows + '</table></div>';
    }} else {{
      const s = d.stats || {{}};
      main.innerHTML = '<div class="summary"><p style="padding:40px;color:#94a3b8">Word-level changes: '
        + '<span class="stat-add">+' + (s.added||0) + '</span> '
        + '<span class="stat-del">-' + (s.removed||0) + '</span>'
        + (s.changed ? ' <span class="stat-chg">~' + s.changed + '</span>' : '')
        + '</p></div>';
    }}
  }} else {{
    setView('inline');
    return;
  }}

  // Update change counter
  const changes = main.querySelectorAll('ins, del');
  document.getElementById('change-counter').textContent = changes.length > 0
    ? (currentChange + 1) + ' / ' + changes.length + ' changes'
    : 'no changes';
}}

function navChange(dir) {{
  const main = document.getElementById('main');
  const changes = main.querySelectorAll('ins, del');
  if (!changes.length) return;
  document.querySelectorAll('.change-focus').forEach(el => el.classList.remove('change-focus'));
  currentChange = Math.max(0, Math.min(changes.length - 1, currentChange + dir));
  changes[currentChange].classList.add('change-focus');
  changes[currentChange].scrollIntoView({{ behavior: 'smooth', block: 'center' }});
  document.getElementById('change-counter').textContent = (currentChange + 1) + ' / ' + changes.length + ' changes';
}}

function syncScroll(container) {{
  const panes = container.querySelectorAll('.pane');
  if (panes.length < 2) return;
  let syncing = false;
  panes.forEach((source) => {{
    source.addEventListener('scroll', () => {{
      if (syncing) return;
      syncing = true;
      const pct = source.scrollTop / (source.scrollHeight - source.clientHeight || 1);
      panes.forEach((target) => {{
        if (target !== source) {{
          target.scrollTop = pct * (target.scrollHeight - target.clientHeight || 1);
        }}
      }});
      syncing = false;
    }});
  }});
}}

function esc(s) {{ const d = document.createElement('span'); d.textContent = s; return d.innerHTML; }}

// Keyboard
document.addEventListener('keydown', e => {{
  if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
  const key = e.key;
  if (key === '?') {{ document.getElementById('help').classList.toggle('show'); e.preventDefault(); }}
  else if (key === 'Escape') {{ document.getElementById('help').classList.remove('show'); }}
  else if (key === 'j') navChange(1);
  else if (key === 'k') navChange(-1);
  else if (key === 'n') toggleNorm();
  else if (key === 'f') {{ if (DATA.files.length > 1) selectFile(Math.min(currentFile + 1, DATA.files.length - 1)); }}
  else if (key === 'F') {{ if (DATA.files.length > 1) selectFile(Math.max(currentFile - 1, 0)); }}
  else if (key === '1') setView('inline');
  else if (key === '2') setView('split');
  else if (key === '3') setView('triple');
  else if (key === '4') setView('rendered');
  else if (key === '5') setView('text');
  else if (key === '6') setView('summary');
}});

// Init
renderFile();
</script>
</body>
</html>"""


# ── HTML generation ──

def compute_file_data(name, old_text, new_text, content_type):
    """Compute all diff representations for a file pair."""
    differ = DIFFERS.get(content_type, diff_prose)
    normalizer = NORMALIZERS.get(content_type, normalize_text)

    old_norm = normalizer(old_text)
    new_norm = normalizer(new_text)

    raw_diff = differ(old_text, new_text)
    norm_diff = differ(old_norm, new_norm)

    identical = (old_norm == new_norm)

    return {
        "name": name,
        "type": content_type,
        "identical": identical,
        "diffs": {
            "raw": raw_diff,
            "norm": norm_diff,
        },
    }


def build_stats_html(file_data):
    parts = []
    for f in file_data:
        d = f["diffs"]["norm"]
        s = d.get("stats", {})
        if s.get("added"):
            parts.append(f'<span class="stat-add">+{s["added"]}</span>')
        if s.get("removed"):
            parts.append(f'<span class="stat-del">-{s["removed"]}</span>')
        if s.get("changed"):
            parts.append(f'<span class="stat-chg">~{s["changed"]}</span>')
    return " ".join(parts) if parts else '<span style="color:#64748b">no changes</span>'


def build_sidebar_html(file_data):
    if len(file_data) <= 1:
        return ""
    parts = []
    for i, f in enumerate(file_data):
        s = f["diffs"]["norm"].get("stats", {})
        stat_str = ""
        if s.get("added") or s.get("removed"):
            stat_str = f'<div class="fstats">+{s.get("added",0)} -{s.get("removed",0)}</div>'
        active = "active" if i == 0 else ""
        parts.append(
            f'<div class="file {active}" onclick="selectFile({i})">'
            f'{html_module.escape(f["name"])}{stat_str}</div>'
        )
    return "\n".join(parts)


def has_rendered_view(file_data):
    for f in file_data:
        for key in ("norm", "raw"):
            if f["diffs"][key].get("rendered_merged"):
                return True
    return False


def generate_html(file_data, old_name, new_name):
    if len(file_data) == 1:
        header = f'<b>{html_module.escape(file_data[0]["name"])}</b> ({file_data[0]["type"]})'
    else:
        header = f'<b>{len(file_data)} files</b>'

    extra_buttons = ""
    if has_rendered_view(file_data):
        extra_buttons = '<button onclick="setView(\'rendered\')" id="btn-rendered">Rendered</button>'

    sidebar_display = "block" if len(file_data) > 1 else "none"

    # Prepare JSON data — serialize diff results
    json_files = []
    for f in file_data:
        jf = {
            "name": f["name"],
            "type": f["type"],
            "identical": f["identical"],
            "diffs": {},
        }
        for key in ("raw", "norm"):
            d = f["diffs"][key]
            jd = {
                "inline": d.get("inline", ""),
                "split_old": d.get("split_old", ""),
                "split_new": d.get("split_new", ""),
                "stats": d.get("stats", {}),
            }
            if d.get("rendered_merged"):
                jd["rendered_merged"] = d["rendered_merged"]
            if d.get("text_inline"):
                jd["text_inline"] = d["text_inline"]
                jd["text_old"] = d.get("text_old", "")
                jd["text_new"] = d.get("text_new", "")
            if d.get("changes"):
                jd["changes"] = d["changes"]
            jf["diffs"][key] = jd
        json_files.append(jf)

    json_data = json.dumps({"files": json_files}, ensure_ascii=False)

    # Compute initial content for first file
    first = file_data[0]
    d = first["diffs"]["norm"]
    if first["identical"]:
        content_html = '<div class="identical"><p>Files are identical</p><span>after normalization</span></div>'
    else:
        cls = "" if first["type"] == "json" else "prose"
        content_html = f'<article class="{cls}">{d.get("inline", "")}</article>'

    return TEMPLATE.format(
        title=html_module.escape(f"{old_name} vs {new_name}" if new_name else old_name),
        header_html=header,
        stats_html=build_stats_html(file_data),
        extra_view_buttons=extra_buttons,
        sidebar_display=sidebar_display,
        sidebar_html=build_sidebar_html(file_data),
        content_html=content_html,
        json_data=json_data,
    )


def open_in_browser(html_content, name):
    name_hash = hashlib.md5(name.encode()).hexdigest()[:8]
    tmp_path = Path(tempfile.gettempdir()) / f"differ-{name_hash}.html"
    tmp_path.write_text(html_content, encoding="utf-8")
    print(str(tmp_path), file=sys.stderr)
    subprocess.run(["open", str(tmp_path)])


# ── Main ──

parser = argparse.ArgumentParser(description="Word-level diff viewer for content files")
parser.add_argument("old", nargs="?", help="file path, git range, or - for stdin")
parser.add_argument("new", nargs="?", help="file path (optional for git mode)")
parser.add_argument("--type", choices=["html", "json", "markdown", "text"],
                    help="force content type (default: auto-detect)")
parser.add_argument("--format", choices=["browser", "txt"], default="browser",
                    help="output format (default: browser)")
parser.add_argument("--staged", action="store_true",
                    help="diff all staged changes")
parser.add_argument("--commit", metavar="REF",
                    help="diff a specific commit")
parser.add_argument("--no-open", action="store_true",
                    help="write HTML, print path, don't open browser")


def main():
    args = parser.parse_args()

    if not args.old and not args.staged and not args.commit:
        parser.print_help()
        sys.exit(2)

    file_pairs = resolve_inputs(args)

    if not file_pairs:
        print("no files to diff", file=sys.stderr)
        sys.exit(0)

    # Plain text mode
    if args.format == "txt":
        for name, old_text, new_text in file_pairs:
            print(diff_txt(old_text, new_text, f"a/{name}", f"b/{name}"))
        return

    # Compute diffs for all files
    file_data = []
    for name, old_text, new_text in file_pairs:
        content_type = args.type or detect_type(name, new_text or old_text)
        print(f"diffing {name} ({content_type})...", file=sys.stderr)
        fd = compute_file_data(name, old_text, new_text, content_type)
        file_data.append(fd)

    old_name = args.old or "staged"
    new_name = args.new or ""
    html_content = generate_html(file_data, old_name, new_name)

    if args.no_open:
        name_hash = hashlib.md5(old_name.encode()).hexdigest()[:8]
        tmp_path = Path(tempfile.gettempdir()) / f"differ-{name_hash}.html"
        tmp_path.write_text(html_content, encoding="utf-8")
        print(str(tmp_path))
    else:
        open_in_browser(html_content, old_name)


if __name__ == "__main__":
    main()
