# ── Format detection ──

EXT_MAP = {
    ".html": "html", ".htm": "html", ".xml": "html", ".xhtml": "html",
    ".json": "json", ".geojson": "json",
    ".md": "markdown", ".markdown": "markdown", ".mdx": "markdown",
    ".txt": "text", ".text": "text", ".log": "text",
    ".csv": "text", ".tsv": "text",
}


def detect_type(path, content):
    ext = Path(path).suffix.lower()
    if ext in EXT_MAP:
        return EXT_MAP[ext]
    stripped = content.strip()
    if stripped.startswith(("{", "[")):
        try:
            json.loads(stripped)
            return "json"
        except json.JSONDecodeError:
            pass
    if re.match(r"<(!DOCTYPE|html|head|body|div|article|section|p\b)", stripped, re.I):
        return "html"
    if re.search(r"^#{1,6}\s", stripped, re.MULTILINE):
        return "markdown"
    return "text"


# ── Normalization ──

def normalize_html(text):
    from lxml import etree
    try:
        doc = etree.HTML(text)
        return etree.tostring(doc, encoding="unicode", method="html", pretty_print=True)
    except Exception:
        return re.sub(r"\s+", " ", text).strip()


def normalize_json(text):
    try:
        obj = json.loads(text)
        return json.dumps(obj, indent=2, sort_keys=True, ensure_ascii=False)
    except json.JSONDecodeError:
        return text


def normalize_markdown(text):
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    text = re.sub(r"[ \t]+$", "", text, flags=re.MULTILINE)
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text.strip() + "\n"


def normalize_text(text):
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    text = re.sub(r"[ \t]+$", "", text, flags=re.MULTILINE)
    return text.strip() + "\n"


NORMALIZERS = {
    "html": normalize_html,
    "json": normalize_json,
    "markdown": normalize_markdown,
    "text": normalize_text,
}


# ── Text extraction (strip markup for text-only view) ──

def extract_text_html(text):
    """Strip HTML tags, decode entities, return plain text."""
    from lxml import etree
    try:
        doc = etree.HTML(text)
        return etree.tostring(doc, method="text", encoding="unicode") or ""
    except Exception:
        return re.sub(r"<[^>]+>", " ", html_module.unescape(text))


def extract_text_json(text):
    """Extract all string values from JSON, stripping any embedded HTML."""
    try:
        obj = json.loads(text)
    except json.JSONDecodeError:
        return text
    strings = []
    def strip_html(s):
        s = html_module.unescape(s)
        s = re.sub(r"<br\s*/?>", "\n", s, flags=re.I)
        s = re.sub(r"<[^>]+>", " ", s)
        s = re.sub(r"  +", " ", s)
        return s.strip()
    def walk(v):
        if isinstance(v, str):
            cleaned = strip_html(v) if ("<" in v or "&" in v) else v
            if cleaned:
                strings.append(cleaned)
        elif isinstance(v, dict):
            for k in sorted(v.keys()):
                strings.append(f"{k}:")
                walk(v[k])
        elif isinstance(v, list):
            for item in v:
                walk(item)
    walk(obj)
    return "\n".join(strings)


def pretty_html(text):
    """Put HTML tags on their own lines for readable source diffs."""
    # Insert newlines before block-level tags
    text = re.sub(r"(<(?:div|p|br|h[1-6]|ul|ol|li|table|tr|td|th|section|article|header|footer|nav|aside|main|details|summary|blockquote|pre|figure|figcaption|form|fieldset|strong|em|a |img |span |/div|/p|/h[1-6]|/ul|/ol|/li|/table|/tr|/td|/th|/section|/article|/header|/footer|/nav|/aside|/main|/details|/summary|/blockquote|/pre|/figure|/figcaption|/form|/fieldset))", r"\n\1", text)
    # Collapse multiple blank lines
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text.strip()


# ── Diff engines ──

def diff_words_tokenize(text):
    """Split text into word tokens preserving whitespace as separate tokens."""
    return re.findall(r"\S+|\s+", text)


def diff_prose(old_text, new_text):
    import diff_match_patch as dmp_module
    dmp = dmp_module.diff_match_patch()

    # Word-level diffing: map words → unique chars, diff, then expand
    old_words = diff_words_tokenize(old_text)
    new_words = diff_words_tokenize(new_text)

    vocab = {}
    def word_to_char(w):
        if w not in vocab:
            vocab[w] = chr(len(vocab) + 0x100)
        return vocab[w]

    old_encoded = "".join(word_to_char(w) for w in old_words)
    new_encoded = "".join(word_to_char(w) for w in new_words)

    char_to_word = {v: k for k, v in vocab.items()}

    diffs = dmp.diff_main(old_encoded, new_encoded, False)
    dmp.diff_cleanupSemantic(diffs)

    inline_parts = []
    old_parts = []
    new_parts = []
    added_words = 0
    removed_words = 0

    for op, encoded in diffs:
        text = "".join(char_to_word.get(c, c) for c in encoded)
        escaped = html_module.escape(text).replace("\n", "<br>\n")
        if op == 0:
            inline_parts.append(f'<span class="eq">{escaped}</span>')
            old_parts.append(f'<span class="eq">{escaped}</span>')
            new_parts.append(f'<span class="eq">{escaped}</span>')
        elif op == -1:
            inline_parts.append(f'<del>{escaped}</del>')
            old_parts.append(f'<del>{escaped}</del>')
            removed_words += len(text.split())
        elif op == 1:
            inline_parts.append(f'<ins>{escaped}</ins>')
            new_parts.append(f'<ins>{escaped}</ins>')
            added_words += len(text.split())

    return {
        "inline": "".join(inline_parts),
        "split_old": "".join(old_parts),
        "split_new": "".join(new_parts),
        "stats": {"added": added_words, "removed": removed_words},
    }


def diff_html_content(old_text, new_text):
    from lxml.html.diff import htmldiff
    try:
        merged = htmldiff(old_text, new_text)
    except Exception:
        return diff_prose(old_text, new_text)

    # Pretty-printed source diff (tags on lines)
    source_diff = diff_prose(pretty_html(old_text), pretty_html(new_text))

    # Text-only diff (strip all tags)
    old_plain = extract_text_html(old_text)
    new_plain = extract_text_html(new_text)
    text_diff = diff_prose(old_plain, new_plain)

    # Count changes in the merged HTML
    added = len(re.findall(r"<ins[\s>]", merged))
    removed = len(re.findall(r"<del[\s>]", merged))

    return {
        "inline": merged,
        "split_old": source_diff["split_old"],
        "split_new": source_diff["split_new"],
        "rendered_old": old_text,
        "rendered_new": new_text,
        "rendered_merged": merged,
        "text_inline": text_diff["inline"],
        "text_old": text_diff["split_old"],
        "text_new": text_diff["split_new"],
        "stats": {"added": added, "removed": removed},
    }


def diff_json_content(old_text, new_text):
    from deepdiff import DeepDiff

    old_pretty = normalize_json(old_text)
    new_pretty = normalize_json(new_text)

    try:
        old_obj = json.loads(old_text)
        new_obj = json.loads(new_text)
        dd = DeepDiff(old_obj, new_obj, verbose_level=2)
    except Exception:
        return diff_prose(old_text, new_text)

    changes = []
    change_types = [
        "values_changed", "dictionary_item_added", "dictionary_item_removed",
        "iterable_item_added", "iterable_item_removed", "type_changes",
    ]
    for ct in change_types:
        for path, detail in dd.get(ct, {}).items():
            entry = {"path": path, "type": ct.replace("_", " ")}
            if isinstance(detail, dict):
                entry["old"] = str(detail.get("old_value", ""))
                entry["new"] = str(detail.get("new_value", ""))
            else:
                entry["new"] = str(detail)
            changes.append(entry)

    # Also compute line-level diff of pretty-printed JSON for split view
    source_diff = diff_prose(old_pretty, new_pretty)

    # Text-only diff (just string values)
    old_plain = extract_text_json(old_text)
    new_plain = extract_text_json(new_text)
    text_diff = diff_prose(old_plain, new_plain)

    n_added = len(dd.get("dictionary_item_added", {})) + len(dd.get("iterable_item_added", {}))
    n_removed = len(dd.get("dictionary_item_removed", {})) + len(dd.get("iterable_item_removed", {}))
    n_changed = len(dd.get("values_changed", {})) + len(dd.get("type_changes", {}))

    return {
        "inline": source_diff["inline"],
        "split_old": source_diff["split_old"],
        "split_new": source_diff["split_new"],
        "text_inline": text_diff["inline"],
        "text_old": text_diff["split_old"],
        "text_new": text_diff["split_new"],
        "changes": changes,
        "stats": {"added": n_added, "removed": n_removed, "changed": n_changed},
    }


def diff_markdown_content(old_text, new_text):
    import markdown as md_lib

    source_diff = diff_prose(old_text, new_text)

    # Rendered view: convert to HTML and diff
    old_html = md_lib.markdown(old_text)
    new_html = md_lib.markdown(new_text)
    try:
        from lxml.html.diff import htmldiff
        rendered_merged = htmldiff(old_html, new_html)
    except Exception:
        rendered_merged = None

    result = source_diff.copy()
    if rendered_merged:
        result["rendered_old"] = old_html
        result["rendered_new"] = new_html
        result["rendered_merged"] = rendered_merged
    return result


DIFFERS = {
    "html": diff_html_content,
    "json": diff_json_content,
    "markdown": diff_markdown_content,
    "text": diff_prose,
}


# ── Plain text output ──

def diff_txt(old_text, new_text, old_name="old", new_name="new"):
    import difflib
    old_lines = old_text.splitlines(keepends=True)
    new_lines = new_text.splitlines(keepends=True)
    return "".join(difflib.unified_diff(old_lines, new_lines,
                                        fromfile=old_name, tofile=new_name))


# ── Git integration ──

def git_run(*cmd):
    r = subprocess.run(["git"] + list(cmd), capture_output=True, text=True)
    if r.returncode != 0:
        return None
    return r.stdout


def git_show(ref, path):
    return git_run("show", f"{ref}:{path}")


def git_root():
    r = git_run("rev-parse", "--show-toplevel")
    return r.strip() if r else None


def resolve_inputs(args):
    """Return list of (name, old_text, new_text) tuples."""
    files = []

    if args.staged:
        names = git_run("diff", "--staged", "--name-only")
        if not names:
            print("no staged changes", file=sys.stderr)
            sys.exit(0)
        root = git_root()
        for name in names.strip().splitlines():
            old = git_show("HEAD", name) or ""
            new = git_show(":", name) or ""
            files.append((name, old, new))
        return files

    if args.commit:
        names = git_run("diff-tree", "--no-commit-id", "-r", "--name-only", args.commit)
        if not names:
            print(f"no changes in {args.commit}", file=sys.stderr)
            sys.exit(0)
        for name in names.strip().splitlines():
            old = git_show(f"{args.commit}~1", name) or ""
            new = git_show(args.commit, name) or ""
            files.append((name, old, new))
        return files

    old_arg = args.old
    new_arg = args.new

    # Range: differ HEAD~3.. file or differ main..feature
    if old_arg and ".." in old_arg:
        ref_range = old_arg
        specific_file = new_arg
        names_cmd = ["diff", "--name-only", ref_range]
        if specific_file:
            names_cmd.append("--")
            names_cmd.append(specific_file)
        names = git_run(*names_cmd)
        if not names:
            print(f"no changes in {ref_range}", file=sys.stderr)
            sys.exit(0)
        parts = ref_range.split("..")
        old_ref = parts[0] or "HEAD"
        new_ref = parts[1] if parts[1] else "HEAD"
        for name in names.strip().splitlines():
            old = git_show(old_ref, name) or ""
            new = git_show(new_ref, name) or ""
            files.append((name, old, new))
        return files

    # Single file: differ file.html → working copy vs HEAD
    if old_arg and not new_arg and old_arg != "-":
        path = Path(old_arg)
        if not path.exists():
            print(f"file not found: {old_arg}", file=sys.stderr)
            sys.exit(2)
        # Get path relative to git root
        root = git_root()
        if root:
            try:
                rel = path.resolve().relative_to(Path(root).resolve())
                old_content = git_show("HEAD", str(rel))
                if old_content is not None:
                    new_content = path.read_text(encoding="utf-8", errors="replace")
                    return [(str(rel), old_content, new_content)]
            except (ValueError, TypeError):
                pass
        print(f"not in a git repo or no HEAD version: {old_arg}", file=sys.stderr)
        sys.exit(1)

    # Two explicit files
    if not old_arg:
        print("no input files", file=sys.stderr)
        sys.exit(2)

    old_text = sys.stdin.read() if old_arg == "-" else Path(old_arg).read_text(encoding="utf-8", errors="replace")
    if not new_arg:
        print("need two files (or use git mode)", file=sys.stderr)
        sys.exit(2)
    new_text = Path(new_arg).read_text(encoding="utf-8", errors="replace")
    name = Path(new_arg).name
    return [(name, old_text, new_text)]


