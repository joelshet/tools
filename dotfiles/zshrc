run() {
    if [ $# -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
        printf '\n  \033[1mrun\033[0m <tool> [args...]   log & execute any command\n\n'
        printf '  \033[2magain          show history  │  again <tool>   re-run last\033[0m\n'
        printf '  \033[2mguide <tool>   prompted run  │  tools          list tools\033[0m\n\n'
        return
    fi
    printf '%s\t%s\t%s\t%s\n' \
        "$(date +%Y-%m-%dT%H:%M)" \
        "$(basename "$1")" \
        "$*" \
        "$PWD" >> "$HOME/.tools/history.tsv"
    "$@"
}

